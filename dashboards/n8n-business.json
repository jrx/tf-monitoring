      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(n8n_workflow_success_total{job=\"$job\"}[5m])) by (workflow_name) / sum(rate(n8n_workflow_started_total{job=\"$job\"}[5m])) by (workflow_name)",
          "legendFormat": "{{workflow_name}}",
          "refId": "A"
        }
      ],
      "title": "Success rate by workflow",
      "type": "timeseries"
    },
