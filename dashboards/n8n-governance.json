  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Production root executions (lifetime)",
      "description": "n8n_production_root_executions: the number n8n's own licence reporting uses. Root executions only (no sub-workflows, no manual, no error-workflow runs); success, error and crashed all count. Lifetime since the database was created; a decrease means a restore or clone, not a restart. Needs N8N_METRICS_INCLUDE_WORKFLOW_STATISTICS; refreshes every 300s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(n8n_production_root_executions{job=\"$job\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Lifetime root executions vs quota",
      "description": "Production root executions as a share of $quota (editable textbox). Lifetime, not per period: to get usage for a contract period, subtract a stored baseline outside Grafana. Colours at 70 / 90 / 100 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(n8n_production_root_executions{job=\"$job\"}) / $quota",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
