      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Executions",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "renameByName": {
              "workflow_name": "Workflow",
              "workflow_id": "ID",
              "Value #A": "Executions",
              "Value #B": "Success ratio"
            },
            "indexByName": {
              "workflow_name": 0,
              "workflow_id": 1,
              "Value #A": 2,
              "Value #B": 3
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, sum by (workflow_id, workflow_name) (((increase(n8n_workflow_started_total{job=\"$job\"}[$__range]) and n8n_workflow_started_total{job=\"$job\"} offset $__range) or (n8n_workflow_started_total{job=\"$job\"} unless n8n_workflow_started_total{job=\"$job\"} offset $__range))))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum by (workflow_id, workflow_name) (((increase(n8n_workflow_success_total{job=\"$job\"}[$__range]) and n8n_workflow_success_total{job=\"$job\"} offset $__range) or (n8n_workflow_success_total{job=\"$job\"} unless n8n_workflow_success_total{job=\"$job\"} offset $__range)))) / (sum by (workflow_id, workflow_name) (((increase(n8n_workflow_started_total{job=\"$job\"}[$__range]) and n8n_workflow_started_total{job=\"$job\"} offset $__range) or (n8n_workflow_started_total{job=\"$job\"} unless n8n_workflow_started_total{job=\"$job\"} offset $__range))))) and on (workflow_id, workflow_name) topk(10, sum by (workflow_id, workflow_name) (((increase(n8n_workflow_started_total{job=\"$job\"}[$__range]) and n8n_workflow_started_total{job=\"$job\"} offset $__range) or (n8n_workflow_started_total{job=\"$job\"} unless n8n_workflow_started_total{job=\"$job\"} offset $__range))))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
