    {
      "id": 7,
      "type": "table",
      "title": "Top 10 workflows by executions (range)",
      "description": "n8n_workflow_started_total by workflow over the range, with success ratio. Needs the workflow_id / workflow_name label flags. Hidden label \"ID\" disambiguates renamed workflows.",
