{
  "id": null,
  "uid": "n8n-audit-events-portable",
  "title": "n8n — Audit Events",
  "description": "Who did what: n8n Enterprise Log Streaming audit events (n8n.audit.*) read from Loki. Identity and access, per-user attribution, workflow lifecycle, credential / API key / MFA changes, execution-data reveals, raw event stream. Needs a licence with Log Streaming, a syslog destination pointed at a Loki-shipping receiver, and the JSON event as the log line. Generated by dashboards/build-audit-dashboard.py.",
  "tags": [
    "n8n",
    "portable"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "loki",
        "label": "Loki",
        "query": "loki",
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      },
      {
        "type": "textbox",
        "name": "stream",
        "label": "Stream selector",
        "description": "Loki label matcher(s) identifying the n8n log-streaming stream, without the braces.",
        "query": "source=\"n8n-log-streaming\"",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "source=\"n8n-log-streaming\"",
          "value": "source=\"n8n-log-streaming\""
        },
        "options": [
          {
            "selected": true,
            "text": "source=\"n8n-log-streaming\"",
            "value": "source=\"n8n-log-streaming\""
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Audit summary",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total audit events",
      "description": "All n8n.audit.* events received in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({${stream:raw}} | json | eventName=~`n8n\\.audit\\..*` [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
