          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "title": "Write bytes/s by mode",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
